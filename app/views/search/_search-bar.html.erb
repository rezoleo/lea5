<%# locals: () -%>

<%= form_with(url: search_path, method: :get, class: "join ms-auto min-w-0 flex-1 sm:flex-none") do |f| %>
  <%= f.text_field :q,
                   required: true,
                   placeholder: "Search users and machines",
                   class: "input input-sm join-item w-full sm:w-52",
                   'aria-label': "Search" %>
  <%= f.button name: nil, class: "btn btn-sm join-item", 'aria-label': "Search" do %>
    <%= svg_icon_tag "icon_search" %>
  <% end %>
<% end %>
