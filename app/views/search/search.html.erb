<%# locals: () -%>

<%# A search that looks like an IP address also matches the machine holding it. %>
<% machines = (Array(@machines) + Array(@ip&.machine)).uniq %>
<h1>Results for "<%= @query %>"</h1>
<section class="panel">
  <%= render "components/card_header", title: "Users" %>
  <%= render "components/list", items: Array(@users), empty: "No matching users" %>
  <% if @pagy_users %>
    <%= render "components/pagination", pagy: @pagy_users %>
  <% end %>
</section>
<section class="panel">
  <%= render "components/card_header", title: "Machines" %>
  <%= render "components/list", items: machines, empty: "No matching machines" %>
  <% if @pagy_machines %>
    <%= render "components/pagination", pagy: @pagy_machines %>
  <% end %>
</section>
