<%# locals: (refund:) -%>

<li class="grid gap-2 border-t border-base-300 px-4 py-3">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4">
    <span class="font-semibold">
      <%= refund.credited_amount.format %> Refunded
      <span class="opacity-60 font-normal"><%= time_with_relative_tag refund.created_at %></span>
    </span>
    <%= link_to download_invoice_path(refund.invoice), class: "btn btn-ghost btn-sm gap-1" do %>
      <%= svg_icon_tag 'icon_pdf' %>
      Credit note
    <% end %>
  </div>

  <ul class="grid gap-1 text-sm opacity-60">
    <% refund.articles_refunds.each do |article_refund| %>
      <li>
        <%= article_refund.article.name %>
        <% if article_refund.quantity > 1 %>×<%= article_refund.quantity %><% end %>
      </li>
    <% end %>
    <% if refund.subscription_refunded? %>
      <li>Subscription cut</li>
    <% end %>
    <% if refund.reason.present? %>
      <li>Reason: <%= refund.reason %></li>
    <% end %>
  </ul>
</li>
