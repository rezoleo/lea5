<%# locals: (api_key:) -%>

<li class="row">
  <span class="font-medium"><%= api_key.name %></span>
  <span class="muted text-sm"><%= time_with_relative_tag api_key.created_at %></span>
  <% if can?(:destroy, api_key) %>
    <div class="ms-auto">
      <%= icon_button 'icon_delete', api_key, method: :delete, label: 'Delete this api key' %>
    </div>
  <% end %>
</li>
