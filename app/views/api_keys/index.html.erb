<%# locals: () -%>

<h1>Api keys</h1>

<section class="panel">
  <%= render "components/card_header",
             title: "Api keys",
             link_text: ("New api key" if can?(:create, ApiKey)),
             link_path: new_api_key_path,
             link_label: "Add a new api key" %>
  <%= render "components/list", items: @api_keys, empty: "No api keys" %>
</section>
