<%# locals: (machine:) -%>

<li class="machine row">
  <span class="font-medium"><%= machine.name %></span>
  <span class="muted font-mono text-sm"><%= machine.mac.upcase %></span>
  <span class="muted font-mono text-sm"><%= machine.ip.ip %></span>
  <div class="ms-auto flex gap-1">
    <% if can?(:edit, machine) %>
      <%= icon_button 'icon_edit', edit_machine_path(machine), label: 'Edit this machine' %>
    <% end %>
    <% if can?(:destroy, machine) %>
      <%= icon_button 'icon_delete', machine, method: :delete, label: 'Delete this machine' %>
    <% end %>
  </div>
</li>
