<%# locals: (owner:, free_access:) -%>

<% min_date = Time.current %>
<%= form_with(model: [owner, free_access], class: 'form') do |f| %>
  <%= render 'utils/error_messages', object: f.object %>
  <%= f.field :start_at, :date_field, required: true, value: free_access.start_at, min: min_date %>
  <%= f.field :end_at, :date_field, required: true, min: min_date %>
  <%= f.field :reason, required: true, size: 30, maxlength: 255, placeholder: 'Leaves in 3 days' %>
  <%= f.submit yield(:button_text) %>
<% end %>
