<%# locals: (free_access:) -%>

<li class="row">
  <span><%= time_with_relative_tag free_access.start_at %>&nbsp;&ndash;&nbsp;<%= time_with_relative_tag free_access.end_at %></span>
  <span class="muted"><%= free_access.reason %></span>
  <div class="ms-auto flex gap-1">
    <% if can?(:edit, free_access) %>
      <%= icon_button 'icon_edit', edit_free_access_path(free_access), label: 'Edit this free access' %>
    <% end %>
    <% if can?(:destroy, free_access) %>
      <%= icon_button 'icon_delete', free_access, method: :delete, label: 'Delete this free access' %>
    <% end %>
  </div>
</li>
