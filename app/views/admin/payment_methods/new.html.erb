<%# locals: () %>

<% provide :button_text, "Create" %>

<%= render "components/page_header", title: "Add a new payment method", back: admin_path %>

<%= form_with(model: @payment_method, class: 'form') do |f| %>
  <%= render 'utils/error_messages', object: f.object %>
  <%= f.field :name %>
  <label class="label gap-2">
    <%= f.check_box :auto_verify %>
    Auto verify
  </label>
  <%= f.submit yield(:button_text) %>
<% end %>