<%# locals: (payment_method:) %>

<li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-3">
  <span class="font-medium"><%= payment_method.name %></span>
  <span class="opacity-60"><%= payment_method.auto_verify? ? "Auto verify" : "Manual verify" %></span>
  <% if can?(:destroy, payment_method) %>
    <div class="ms-auto">
      <%= button_to(payment_method, method: :delete, class: "btn btn-square btn-ghost btn-sm", data: { turbo_confirm: "Are you sure?" }, 'aria-label': 'Delete this payment method') do %>
        <%= svg_icon_tag 'icon_delete' %>
      <% end %>
    </div>
  <% end %>
</li>
