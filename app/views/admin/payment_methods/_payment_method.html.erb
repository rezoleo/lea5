<%# locals: (payment_method:) %>

<li class="row">
  <span class="font-medium"><%= payment_method.name %></span>
  <span class="muted"><%= payment_method.auto_verify? ? "Auto verify" : "Manual verify" %></span>
  <% if can?(:destroy, payment_method) %>
    <div class="ms-auto">
      <%= icon_button 'icon_delete', payment_method, method: :delete, label: 'Delete this payment method' %>
    </div>
  <% end %>
</li>
