<%# locals: (article:) %>

<li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-3">
  <span class="font-medium"><%= article.name %></span>
  <span class="opacity-60"><%= humanized_money_with_symbol(article.price) %></span>
  <% if can?(:destroy, article) %>
    <div class="ms-auto">
      <%= button_to(article, method: :delete, class: "btn btn-square btn-ghost btn-sm", data: { turbo_confirm: "Are you sure?" }, 'aria-label': 'Delete this article') do %>
        <%= svg_icon_tag 'icon_delete' %>
      <% end %>
    </div>
  <% end %>
</li>
