<%# locals: (article:) %>

<li class="row">
  <span class="font-medium"><%= article.name %></span>
  <span class="muted"><%= humanized_money_with_symbol(article.price) %></span>
  <% if can?(:destroy, article) %>
    <div class="ms-auto">
      <%= icon_button 'icon_delete', article, method: :delete, label: 'Delete this article' %>
    </div>
  <% end %>
</li>
