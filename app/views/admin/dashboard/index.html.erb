<%# locals: () %>

<h1>Admin dashboard</h1>

<% if can?(:manage, :all) %>
  <%= link_to 'Accounting dashboard', admin_accounting_path, class: 'button-primary' %>
<% end %>

<% if can?(:read, Article) %>
  <section class="panel">
    <%= render "components/card_header",
               title: "Articles",
               link_text: ("Create article" if can?(:create, Article)),
               link_path: new_article_path,
               link_label: "Create article" %>
    <%= render "components/list", items: @articles, empty: "No articles" %>
  </section>
<% end %>

<% if can?(:read, SubscriptionOffer) %>
  <section class="panel">
    <%= render "components/card_header",
               title: "Subscription offers",
               link_text: ("Create subscription offer" if can?(:create, SubscriptionOffer)),
               link_path: new_subscription_offer_path,
               link_label: "Create subscription offer" %>
    <%= render "components/list", items: @subscription_offers, empty: "No subscription offers" %>
  </section>
<% end %>

<% if can?(:read, PaymentMethod) %>
  <section class="panel">
    <%= render "components/card_header",
               title: "Payment methods",
               link_text: ("Create payment method" if can?(:create, PaymentMethod)),
               link_path: new_payment_method_path,
               link_label: "Create payment method" %>
    <%= render "components/list", items: @payment_methods, empty: "No payment methods" %>
  </section>
<% end %>
