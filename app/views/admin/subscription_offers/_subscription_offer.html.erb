<%# locals: (subscription_offer:) %>

<li class="row">
  <span class="font-medium"><%= pluralize(subscription_offer.duration, 'month') %></span>
  <span class="muted"><%= humanized_money_with_symbol(subscription_offer.price) %></span>
  <% if can?(:destroy, subscription_offer) %>
    <div class="ms-auto">
      <%= icon_button 'icon_delete', subscription_offer, method: :delete, label: 'Delete this subscription offer' %>
    </div>
  <% end %>
</li>
