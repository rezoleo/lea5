<%# locals: () %>

<% provide :button_text, "Create" %>

<div class="flex items-center gap-2">
  <%= render "components/back_link", to: admin_path %>
  <h1>Add a new subscription offer</h1>
</div>

<%= form_with(model: @subscription_offer, class: 'form') do |f| %>
  <%= render 'utils/error_messages', object: f.object %>
  <%= f.field :duration, :number_field, min: 1, step: 1, required: true %>
  <%= f.field :price, :number_field, min: 0, step: 0.01, required: true, placeholder: "0.00" %>
  <%= f.submit yield(:button_text) %>
<% end %>
