<%# locals: () -%>

<% content_for :title, "Accounting" %>

<div class="accounting-dashboard">
  <main class="accounting-container">
    <div class="dashboard-header">
      <h1>Accounting</h1>

      <div class="period-selector">
        <%= form_with url: admin_accounting_path, method: :get, class: "period-form" do |f| %>
          <%= f.select :period,
                       options_for_select([
                                            ['Current Month', 'current_month'],
                                            ['Last Month', 'last_month'],
                                            ['Last 30 Days', 'last_30_days'],
                                            ['Current Year', 'current_year'],
                                            ['Last Year', 'last_year'],
                                            ['All Time', 'all_time'],
                                            ['Custom Range', 'custom']
                                          ], @period),
                       {},
                       class: 'period-select',
                       onchange: 'this.form.submit()' %>

          <% if @period == 'custom' %>
            <div class="custom-date-inputs">
              <%= f.date_field :start_date, value: @start_date.to_date, class: 'date-input' %>
              <%= f.date_field :end_date, value: @end_date.to_date, class: 'date-input' %>
              <%= f.submit 'Apply', class: 'button-primary' %>
            </div>
          <% end %>
        <% end %>

        <%= link_to 'Export CSV',
                    export_csv_admin_accounting_path(
                      period: @period,
                      start_date: @start_date.to_date,
                      end_date: @end_date.to_date
                    ),
                    class: 'button-secondary' %>
      </div>
    </div>

    <p class="date-range">
      <strong>Period:</strong>
      <%= @start_date.strftime('%B %d, %Y') %> - <%= @end_date.strftime('%B %d, %Y') %>
    </p>

    <div class="kpi-cards">
      <div class="kpi-card">
        <div class="kpi-label">Total Revenue</div>
        <div class="kpi-value"><%= @kpis[:total_revenue].format %></div>
        <% if @kpis[:growth_rate].nil? %>
          <div class="kpi-change">
            <span class="kpi-meta">No comparable period last year</span>
          </div>
        <% else %>
          <div class="kpi-change <%= @kpis[:growth_rate] >= 0 ? 'positive' : 'negative' %>">
            <%= @kpis[:growth_rate] >= 0 ? '↑' : '↓' %>
            <%= number_to_percentage(@kpis[:growth_rate].abs, precision: 2) %>
            <span class="kpi-meta">vs same period last year</span>
          </div>
        <% end %>
      </div>

      <div class="kpi-card">
        <div class="kpi-label">Verified Sales</div>
        <div class="kpi-value"><%= number_with_delimiter(@kpis[:transaction_count]) %></div>
      </div>

      <div class="kpi-card">
        <div class="kpi-label">Subscription Months Sold</div>
        <div class="kpi-value"><%= number_with_delimiter(@kpis[:total_months_sold]) %></div>
      </div>
    </div>

    <section class="dashboard-section full-width">
      <h2>Revenue Over Time</h2>
      <div class="chart-container">
        <%= column_chart @revenue_data, suffix: ' €', height: '350px' %>
      </div>
    </section>
  </main>
</div>
