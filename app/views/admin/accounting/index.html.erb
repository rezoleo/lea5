<%# locals: () -%>

<% content_for :title, "Accounting" %>

<%= javascript_import_module_tag "Chart.bundle", "chartkick" %>

<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
  <%= render "components/page_header",
             title: "Accounting",
             back: admin_path,
             subtitle: "#{@start_date.strftime('%b %-d, %Y')} – #{@end_date.strftime('%b %-d, %Y')}" %>

  <div class="flex flex-wrap items-center gap-2">
    <%= form_with url: admin_accounting_path, method: :get, class: "flex flex-wrap items-center gap-2" do |f| %>
      <%= f.select :period,
                   options_for_select([
                                        ['Current month', 'current_month'],
                                        ['Last month', 'last_month'],
                                        ['Last 30 days', 'last_30_days'],
                                        ['Current year', 'current_year'],
                                        ['Last year', 'last_year'],
                                        ['All time', 'all_time'],
                                        ['Custom range', 'custom']
                                      ], @period),
                   {},
                   class: 'select select-sm w-auto',
                   'aria-label': 'Period',
                   onchange: 'this.form.submit()' %>

      <% if @period == 'custom' %>
        <%= f.date_field :start_date, value: @start_date.to_date, class: 'input input-sm w-auto', 'aria-label': 'Start date' %>
        <%= f.date_field :end_date, value: @end_date.to_date, class: 'input input-sm w-auto', 'aria-label': 'End date' %>
        <%= f.submit 'Apply', class: 'btn btn-primary btn-sm' %>
      <% end %>
    <% end %>

    <%= link_to 'Export CSV',
                export_csv_admin_accounting_path(period: @period,
                                                 start_date: @start_date.to_date,
                                                 end_date: @end_date.to_date),
                class: 'btn btn-outline btn-sm' %>
  </div>
</div>

<section class="panel">
  <dl class="stats stats-vertical sm:stats-horizontal">
    <div class="stat">
      <dt class="stat-title">Revenue</dt>
      <dd class="stat-value"><%= @kpis[:total_revenue].format %></dd>
      <dd class="stat-desc">
        <% growth = @kpis[:growth_rate] %>
        <% if growth.nil? %>
          No comparable period last year
        <% else %>
          <span class="<%= growth >= 0 ? 'text-success' : 'text-error' %>">
            <%= growth >= 0 ? '↑' : '↓' %> <%= number_to_percentage(growth.abs, precision: 1) %>
          </span>
          vs same period last year
        <% end %>
      </dd>
    </div>
    <div class="stat">
      <dt class="stat-title">Verified sales</dt>
      <dd class="stat-value"><%= number_with_delimiter(@kpis[:sales_count]) %></dd>
    </div>
    <div class="stat">
      <dt class="stat-title">Subscription months sold</dt>
      <dd class="stat-value"><%= number_with_delimiter(@kpis[:total_months_sold]) %></dd>
    </div>
  </dl>
</section>

<section class="panel">
  <%= render "components/card_header", title: "Revenue over time" %>
  <div class="p-4">
    <%# Chart.js draws on a canvas and can't read the theme's oklch variables; this is the primary, tuned to read on both themes. %>
    <%= column_chart @revenue_data, suffix: ' €', height: '320px', dataset: { backgroundColor: '#c4264f', borderWidth: 0 } %>
  </div>
</section>
