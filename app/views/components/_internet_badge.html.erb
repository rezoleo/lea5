<%# locals: (user:) -%>

<% if not user.internet_access? %>
  <span class="badge badge-error badge-soft gap-1">
    <%= svg_icon_tag 'cross' %>
    No internet
  </span>
<% elsif user.internet_expiration < Time.current + 7.days %>
  <span class="badge badge-warning badge-soft gap-1">
    <%= svg_icon_tag 'icon_internet' %>
    Internet expires soon
  </span>
<% else %>
  <span class="badge badge-success badge-soft gap-1">
    <%= svg_icon_tag 'check' %>
    Internet
  </span>
<% end %>
