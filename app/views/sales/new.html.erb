<%# locals: () %>

<%= render "components/page_header", title: "New sale for #{@owner.display_name}", back: user_path(@owner) %>

<% if @subscription_offers.empty? %>
  <div class="alert alert-warning" role="alert">
    <%= svg_icon_tag 'cross' %>
    <span>No subscription offers exist yet, so only articles can be sold. Add one from the admin dashboard.</span>
  </div>
<% end %>

<%= form_with(
      model: [@owner, @sale],
      class: 'form max-w-2xl',
      data: {
        controller: 'sales',
        sales_articles_value: @articles.reduce({}) { |acc, curr| acc[curr[:id]] = curr.price.cents; acc },
        sales_subscriptions_value: @subscription_offers.map { |s| { id: s.id, duration: s.duration, price: s.price.cents } }
      }) do |f| %>
  <%= render 'utils/error_messages', object: f.object %>

  <div data-sales-target="subscription" class="field">
    <%= f.label :duration, "Internet subscription" %>
    <div class="flex flex-wrap items-center gap-3">
      <%= f.number_field :duration,
                         step: 1,
                         min: 0,
                         class: "input w-24",
                         data: { sales_target: 'duration', action: 'sales#updatePrice' } %>
      <span class="muted text-sm">
        months, <span data-sales-target="subPrice">0,00 €</span>
      </span>
    </div>
  </div>

  <%= f.fields_for :articles_sales do |sale_form| %>
    <%= render 'article_sale_fields', form: sale_form, articles: @articles %>
  <% end %>

  <button type="button" id="add_article" class="btn btn-ghost btn-sm justify-self-start" data-action="sales#addArticle:prevent">
    <%= svg_icon_tag 'icon_plus' %>
    Add an article
  </button>

  <template data-sales-target="articleTemplate">
    <%= f.fields_for :articles_sales, ArticlesSale.new, child_index: 'NEW_ARTICLE' do |sale_form| %>
      <%= render 'article_sale_fields', form: sale_form, articles: @articles %>
    <% end %>
  </template>

  <%= f.field :payment_method_id, :collection_select, @payment_methods, :id, :name, prompt: 'Select payment method' %>

  <div class="line border-t border-base-300 pt-4">
    <span class="muted">Total</span>
    <span class="text-xl font-semibold" data-sales-target="totalPrice">0,00 €</span>
  </div>

  <%= f.submit "Create sale" %>
<% end %>
