<%# locals: (form:, articles:) %>

<%# sales_controller.js reads the first select and the first input of this div,
    and deletes the remove button's closest div, so keep them direct children. %>
<div data-sales-target="articles" class="flex flex-wrap items-end gap-3">
  <div class="field">
    <%= form.label :article_id %>
    <%= form.collection_select :article_id, articles, :id,
                               ->(article) { "#{article.name} (#{humanized_money_with_symbol(article.price)})" },
                               { prompt: 'Select an article', required: true },
                               { class: 'select w-56', data: { action: "sales#updatePrice" } } %>
  </div>
  <%= form.field :quantity, :number_field, step: 1, min: 0,
                 value: form.object.quantity || 1, class: "input w-24",
                 data: { action: "sales#updatePrice" } %>
  <button type="button" class="btn btn-square btn-ghost"
          data-action="sales#removeArticle:prevent" aria-label="Remove article">
    <%= svg_icon_tag 'icon_delete' %>
  </button>
</div>
