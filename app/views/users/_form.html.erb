<%# locals: (user:) -%>

<%= form_with(model: user, class: 'form') do |f| %>
  <%= render 'utils/error_messages', object: f.object %>
  <%= f.field :firstname, required: true %>
  <%= f.field :lastname, required: true %>
  <%= f.field :username, required: true %>
  <%= f.field :email, :email_field, required: true %>
  <%= render 'room_field', f: f %>
  <%= f.submit yield(:button_text) %>
<% end %>
