<%# locals: (user:) -%>

<li>
  <%= link_to user, class: "user flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-3 hover:bg-base-200" do %>
    <span class="font-medium"><%= user.firstname %> <%= user.lastname %></span>
    <span class="text-sm opacity-60"><%= user.room&.number %></span>
    <span class="ms-auto"><%= render "components/internet_badge", user: user %></span>
  <% end %>
</li>
