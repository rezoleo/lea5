<%# locals: () -%>

<% browse_users = can?(:read, User.new) %>

<header class="sticky top-0 z-30 border-b border-base-300 bg-base-100">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-2 p-2 sm:px-6">
    <%= link_to root_path, class: "btn btn-ghost gap-2 px-2 text-base" do %>
      <%= image_tag "rezoleo_logo.png", alt: "", class: "size-6" %>
      Lea5
    <% end %>
    <%# Drops to its own scrollable row on phones so the search keeps its width. %>
    <nav class="order-last -mx-2 flex w-full gap-1 overflow-x-auto px-2 sm:order-none sm:mx-0 sm:w-auto sm:flex-1 sm:px-0">
      <% if logged_in? %>
        <%= nav_link "My profile", user_path(current_user) %>
        <%= nav_link "Users", users_path if browse_users %>
      <% end %>
      <% if can?(:manage, :all) %>
        <%= nav_link "API keys", api_keys_path %>
        <%= nav_link "Admin", admin_path %>
      <% end %>
    </nav>
    <%= render "search/search-bar" if browse_users %>
    <%= render "layouts/auth_buttons" %>
  </div>
</header>
