<%# locals: () -%>

<header class="sticky top-0 z-30 border-b border-base-300 bg-base-100">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-2 p-2 sm:px-6">
    <%= link_to root_path, class: "btn btn-ghost gap-2 px-2 text-base" do %>
      <%= image_tag "rezoleo_logo.png", alt: "", class: "size-6" %>
      Lea5
    <% end %>
    <nav class="flex flex-1 flex-wrap items-center gap-1">
      <% if logged_in? %>
        <%= link_to "My profile", profile_path, class: "btn btn-ghost btn-sm" %>
        <%= link_to "Users", users_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
      <% if can?(:manage, :all) %>
        <%= link_to "Api keys", api_keys_path, class: "btn btn-ghost btn-sm" %>
        <%= link_to "Admin", admin_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
    </nav>
    <%= render "search/search-bar" %>
    <%= render "layouts/auth_buttons" %>
  </div>
</header>
