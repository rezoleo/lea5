<%# locals: () -%>

<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title) || "Lea5" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <%# Disable Turbo link prefetching: https://turbo.hotwired.dev/handbook/drive#prefetching-links-on-hover %>
  <meta name="turbo-prefetch" content="false">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body class="min-h-dvh bg-base-200 text-base-content">
<%= render 'layouts/header' %>

<main class="mx-auto grid w-full max-w-5xl gap-6 p-4 sm:p-6">
  <% flash.each do |message_type, message| %>
    <% style = flash_style(message_type) %>
    <%= tag.div class: "alert #{style[:class]}", role: "status" do %>
      <%= svg_icon_tag style[:icon] %>
      <span><%= message %></span>
    <% end %>
  <% end %>

  <%= yield %>
</main>
</body>
</html>
